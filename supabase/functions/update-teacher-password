// @ts-ignore: Supabase Edge Functions resolve HTTPS imports at runtime.
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.58.0";

declare const Deno: {
  env: {
    get(name: string): string | undefined;
  };
  serve(
    handler: (request: Request) => Response | Promise<Response>,
  ): void;
};

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Access-Control-Allow-Headers":
    "Content-Type, Authorization, X-Client-Info, Apikey",
};

const jsonHeaders = {
  ...corsHeaders,
  "Content-Type": "application/json",
};

function jsonResponse(
  body: Record<string, unknown>,
  status: number,
): Response {
  return new Response(JSON.stringify(body), {
    status,
    headers: jsonHeaders,
  });
}

function isValidUUID(value: string): boolean {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    value,
  );
}

Deno.serve(async (req: Request) => {
  // ---------------------------------------------------------
  // 1. CORS preflight
  // ---------------------------------------------------------
  if (req.method === "OPTIONS") {
    return new Response(null, {
      status: 200,
      headers: corsHeaders,
    });
  }

  // ---------------------------------------------------------
  // 2. Only POST is allowed
  // ---------------------------------------------------------
  if (req.method !== "POST") {
    return jsonResponse(
      {
        error: "Method not allowed",
      },
      405,
    );
  }

  try {
    // -------------------------------------------------------
    // 3. Get Supabase environment variables
    // -------------------------------------------------------
    const supabaseUrl =
      Deno.env.get("SUPABASE_URL") || "";

    const anonKey =
      Deno.env.get("SUPABASE_ANON_KEY") || "";

    const serviceRoleKey =
      Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") || "";

    if (!supabaseUrl || !anonKey || !serviceRoleKey) {
      console.error(
        "Missing required Supabase environment variables.",
      );

      return jsonResponse(
        {
          error: "Server not configured",
        },
        500,
      );
    }

    // -------------------------------------------------------
    // 4. Get Authorization header
    // -------------------------------------------------------
    const authorization =
      req.headers.get("Authorization");

    if (!authorization?.startsWith("Bearer ")) {
      return jsonResponse(
        {
          error: "Unauthorized",
        },
        401,
      );
    }

    const accessToken = authorization
      .slice("Bearer ".length)
      .trim();

    if (!accessToken) {
      return jsonResponse(
        {
          error: "Unauthorized",
        },
        401,
      );
    }

    // -------------------------------------------------------
    // 5. Verify authenticated user
    // -------------------------------------------------------
    const authClient = createClient(
      supabaseUrl,
      anonKey,
      {
        auth: {
          autoRefreshToken: false,
          persistSession: false,
        },
        global: {
          headers: {
            Authorization: `Bearer ${accessToken}`,
          },
        },
      },
    );

    const {
      data: { user },
      error: userError,
    } = await authClient.auth.getUser();

    if (userError || !user) {
      console.error(
        "Authentication verification failed:",
        userError?.message || "No authenticated user",
      );

      return jsonResponse(          
        {
          error: "Unauthorized",
        },
        401,
      );
    }

    // -------------------------------------------------------
    // 6. Create service-role client
    // -------------------------------------------------------
    const adminClient = createClient(
      supabaseUrl,
      serviceRoleKey,
      {
        auth: {
          autoRefreshToken: false,
          persistSession: false,
        },
      },
    );

    // -------------------------------------------------------
    // 7. Verify current user is an ADMIN
    // -------------------------------------------------------
    const {
      data: currentProfile,
      error: currentProfileError,
    } = await adminClient
      .from("profiles")
      .select("id, role")
      .eq("id", user.id)
      .maybeSingle();

    if (currentProfileError) {
      console.error(
        "Failed to load current profile:",
        currentProfileError.message,
      );

      return jsonResponse(
        {
          error:
            "Unable to verify administrator privileges",
        },
        403,
      );
    }

    if (!currentProfile) {
      return jsonResponse(
        {
          error:
            "Administrator profile not found",
        },
        403,
      );
    }

    if (currentProfile.role !== "admin") {
      return jsonResponse(
        {
          error: "Admin access required",
        },
        403,
      );
    }

    // -------------------------------------------------------
    // 8. Parse request body
    // -------------------------------------------------------
    let body: {
      profile_id?: unknown;
      password?: unknown;
    };

    try {
      body = await req.json();
    } catch {
      return jsonResponse(
        {
          error: "Invalid JSON request body",
        },
        400,
      );
    }

    // -------------------------------------------------------
    // 9. Validate profile_id
    // -------------------------------------------------------
    if (typeof body.profile_id !== "string") {
      return jsonResponse(
        {
          error: "profile_id must be a string",
        },
        400,
      );
    }

    const profileId = body.profile_id.trim();

    if (!profileId) {
      return jsonResponse(
        {
          error: "Missing profile_id",
        },
        400,
      );
    }

    if (!isValidUUID(profileId)) {
      return jsonResponse(
        {
          error: "Invalid profile_id format",
        },
        400,
      );
    }

    // -------------------------------------------------------
    // 10. Validate password
    // -------------------------------------------------------
    if (typeof body.password !== "string") {
      return jsonResponse(
        {
          error: "Password must be a string",
        },
        400,
      );
    }

    const password = body.password;

    if (!password) {
      return jsonResponse(
        {
          error: "Missing password",
        },
        400,
      );
    }

    if (password.length < 6) {
      return jsonResponse(
        {
          error:
            "Password must be at least 6 characters long",
        },
        400,
      );
    }

    // -------------------------------------------------------
    // 11. Verify target teacher
    //
    // teachers.profile_id must match the requested
    // Supabase Auth user ID.
    // -------------------------------------------------------
    const {
      data: targetTeacher,
      error: targetTeacherError,
    } = await adminClient
      .from("teachers")
      .select("id, profile_id")
      .eq("profile_id", profileId)
      .maybeSingle();

    if (targetTeacherError) {
      console.error(
        "Failed to query target teacher:",
        targetTeacherError.message,
      );

      return jsonResponse(
        {
          error:
            "Unable to verify teacher account",
        },
        500,
      );
    }

    if (!targetTeacher) {
      return jsonResponse(
        {
          error:
            "Teacher account not found for this profile_id",
        },
        404,
      );
    }

    // -------------------------------------------------------
    // 12. Verify teacher profile_id matches requested ID
    // -------------------------------------------------------
    if (targetTeacher.profile_id !== profileId) {
      console.error(
        "Teacher/Auth ID mismatch.",
      );

      return jsonResponse(
        {
          error:
            "Teacher account and Auth ID do not match",
        },
        409,
      );
    }

    // -------------------------------------------------------
    // 13. Verify Auth user exists
    // -------------------------------------------------------
    const {
      data: authUserData,
      error: authUserError,
    } = await adminClient.auth.admin.getUserById(
      profileId,
    );

    if (authUserError) {
      console.error(
        "Failed to verify Auth user:",
        authUserError.message,
      );

      return jsonResponse(
        {
          error: "Unable to verify Auth user",
        },
        500,
      );
    }

    if (!authUserData.user) {
      return jsonResponse(
        {
          error:
            "Auth user not found for this profile_id",
        },
        404,
      );
    }

    // -------------------------------------------------------
    // 14. Final Auth ID consistency check
    // -------------------------------------------------------
    if (authUserData.user.id !== profileId) {
      console.error(
        "Auth user ID mismatch.",
      );

      return jsonResponse(
        {
          error:
            "Auth user ID does not match profile_id",
        },
        409,
      );
    }

    // -------------------------------------------------------
    // 15. Update Supabase Auth password
    // -------------------------------------------------------
    const {
      data: updatedUserData,
      error: updateError,
    } =
      await adminClient.auth.admin.updateUserById(
        profileId,
        {
          password,
        },
      );

    if (updateError) {
      console.error(
        "Failed to update teacher password:",
        updateError.message,
      );

      return jsonResponse(
        {
          error: updateError.message,
        },
        400,
      );
    }

    // -------------------------------------------------------
    // 16. Verify update response
    // -------------------------------------------------------
    if (!updatedUserData.user) {
      console.error(
        "Password update returned no Auth user.",
      );

      return jsonResponse(
        {
          error: "Password update failed",
        },
        500,
      );
    }

    if (updatedUserData.user.id !== profileId) {
      console.error(
        "Updated Auth user ID does not match target profile_id.",
      );

      return jsonResponse(
        {
          error:
            "Password update returned an unexpected Auth user",
        },
        500,
      );
    }

    // -------------------------------------------------------
    // 17. Success
    // -------------------------------------------------------
    return jsonResponse(
      {
        success: true,
        message:
          "Teacher password updated successfully",
      },
      200,
    );
  } catch (err) {
    const message =
      err instanceof Error
        ? err.message
        : "Unknown error";

    console.error(
      "Unexpected update-teacher-password error:",
      message,
    );

    return jsonResponse(
      {
        error: "Internal server error",
      },
      500,
    );
  }
});